# Extraction backend: "openai" (vision) or "local" (offline, pdfplumber +
# geometry). The vision backend falls back to "local" automatically when the
# API key is missing.
EXTRACTOR=openai

# --- OpenAI vision ---
OPENAI_API_KEY=
# OpenAI model used for vision extraction
OPENAI_MODEL=gpt-4o

# Where uploaded and annotated PDFs are stored
STORAGE_DIR=storage
